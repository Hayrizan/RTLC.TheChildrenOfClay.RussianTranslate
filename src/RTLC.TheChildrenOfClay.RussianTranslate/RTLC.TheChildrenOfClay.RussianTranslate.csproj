<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>RTLC.TheChildrenOfClay.RussianTranslate</AssemblyName>
    <RootNamespace>RTLC.TheChildrenOfClay.RussianTranslate</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <Authors>RTLC</Authors>
    <Description>BepInEx 5 Russian localization plugin for The Children of Clay</Description>
    <GameDir Condition="'$(GameDir)' == ''">$(THE_CHILDREN_OF_CLAY_GAME_DIR)</GameDir>
    <ManagedDir>$(GameDir)\TheChildrenOfClay_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
    <DeployPluginDir>$(GameDir)\BepInEx\plugins\RTLC.TheChildrenOfClay.RussianTranslate</DeployPluginDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AC">
      <HintPath>$(ManagedDir)\AC.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.dll')" Text="BepInEx was not found. Pass -p:GameDir=&quot;path to The Children of Clay&quot; (or set THE_CHILDREN_OF_CLAY_GAME_DIR)." />
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')" Text="The game's managed assemblies were not found. Check GameDir and the game installation." />
  </Target>

  <Target Name="DeployToBepInEx" AfterTargets="Build" Condition="Exists('$(GameDir)')">
    <PropertyGroup>
      <BundleAssetPath>$(MSBuildProjectDirectory)\..\..\Assets\rtlc.bundle</BundleAssetPath>
    </PropertyGroup>
    <MakeDir Directories="$(DeployPluginDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployPluginDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(BundleAssetPath)" DestinationFolder="$(DeployPluginDir)" SkipUnchangedFiles="true" Condition="Exists('$(BundleAssetPath)')" />
  </Target>
</Project>
